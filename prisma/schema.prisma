generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      String   @default("VISITOR") // VISITOR, ADMIN, ORGANIZER
  saved     SavedEvent[]
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   // Cultural, Religious, Sports, Exhibition, Mela
  date        String
  time        String
  location    String
  status      String   @default("UPCOMING") // UPCOMING, LIVE, DELAYED, CANCELLED, COMPLETED
  image       String?
  isOfficial  Boolean  @default(true)
  saves       SavedEvent[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavedEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}
